{
  "name": "dsh-stats-line",
  "version": "0.2.0",
  "description": "Compact replacement for the DeepSeek Harness web stats line: shadows id:stats in conversation.composer.dock with a drag-and-drop component composer (settings namespace `stats-line`); the cost component is fed by the `sessionCost` projection (dsh-session-cost)",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./format": {
      "default": "./dist/format.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "rolldown": "^1.2.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node test/settings.mjs && node test/format.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT"
}
