{
  "name": "dsh-session-cost",
  "version": "0.1.0",
  "description": "DSH session projection `sessionCost`: era-based per-provider cost accounting (metered/subscription/unknown, peak windows, cache-write pricing, long-context tiers) with display-currency settings namespace `session-cost`",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./currency": {
      "default": "./dist/currency.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "rolldown": "^1.2.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node test/session-cost.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT"
}
